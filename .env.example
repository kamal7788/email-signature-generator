# Public base URL of your deployed app (no trailing slash).
# Used to generate absolute image URLs in email signatures.
# Example: https://signatures.yourdomain.com
NEXT_PUBLIC_BASE_URL=

# ── Optional login (Basic Auth) ──────────────────────────────────────
# Set BOTH to lock the studio behind a browser login prompt.
# Leave empty for open access (local dev).
# Image/icon GETs (/api/icon, /api/uploads, /uploads) stay public so
# email clients can fetch embedded images without credentials.
AUTH_USERNAME=
AUTH_PASSWORD=

# ── Optional Cloudflare R2 (upload storage) ──────────────────────────
# When all R2_* are set, /api/upload stores files in R2 and returns a
# public https URL. Otherwise uploads fall back to local public/uploads/.
# Create an R2 bucket + API token + public custom domain (or r2.dev URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base for R2 objects: the BUCKET's public URL, NOT the S3 API endpoint.
# Either a connected custom domain (https://img.yourdomain.com) or the
# bucket's r2.dev URL (https://pub-xxxx.r2.dev). No trailing slash.
# R2 dashboard → bucket → Settings → Public access / Custom domain.
R2_PUBLIC_URL=

# Max upload size in MB (0.5–25, default 2). Allowed types: JPEG/PNG/GIF/WebP.
MAX_UPLOAD_MB=2
